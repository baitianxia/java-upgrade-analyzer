{
  "version": "2.0",
  "auto_run_until_checkpoint": true,
  "runtime_controls": {
    "strict_risk_gate": {
      "type": "boolean",
      "default": false,
      "description": "启用后，Step5 门控在存在 uncertain/not_analyzed 时直接阻断，不接受带盲区的影响结论。"
    }
  },
  "steps": [
    {
      "id": "step1",
      "order": 1,
      "title": "分析对象与依赖范围",
      "script": "s1_dep_diff.py",
      "gate": "step1_scope",
      "interaction": {
        "type": "review",
        "status": "awaiting_user_input",
        "question": "请确认构建来源、目标模块和依赖变化范围是否正确。如果原本只想分析某个模块，但结果覆盖了整个项目，请补充正确的模块范围后重新分析。",
        "required_fields": [
          "action"
        ],
        "missing_inputs": [],
        "input_modes": [],
        "input_normalization": {
          "enabled": true,
          "required_fields": [],
          "allowed_actions": [
            "continue",
            "rerun_current_step",
            "cancel"
          ]
        },
        "response_schema": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "continue",
                "rerun_current_step",
                "cancel"
              ]
            },
            "primary_module": {
              "type": "string",
              "description": "当 action=rerun_current_step 时必填。"
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "当 action=rerun_current_step 时必填，可包含一个或多个模块。"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "resume_hint": "若用户要求只分析某个模块，或用户首轮其实已明确模块但本次仍跑成 root 范围，请用结构化用户答复选择 rerun_current_step，并同时传入 primary_module/modules 重跑 Step1。",
        "options": [
          {
            "id": "continue",
            "label": "继续",
            "description": "构建结果和依赖变化范围正确，继续整理升级上下文。"
          },
          {
            "id": "rerun_current_step",
            "label": "按模块重跑",
            "description": "补充一个或多个目标模块，并重新获取这些模块的依赖变化。"
          },
          {
            "id": "cancel",
            "label": "稍后处理",
            "description": "保留当前分析现场，完成复核后再继续。"
          }
        ],
        "action_requirements": {
          "rerun_current_step": {
            "at_least_one_of": [
              "primary_module",
              "modules"
            ],
            "description": "按模块重跑时，至少要明确 primary_module 或 modules。"
          }
        }
      },
      "outputs": [
        "evidence/dependencies/dep_alerts.csv",
        "evidence/dependencies/dep_changes.csv",
        "evidence/dependencies/dep_summary.txt",
        "evidence/dependencies/deps_current_resolved.csv",
        "evidence/dependencies/build_provenance.json",
        "evidence/dependencies/s1_artifacts/",
        "evidence/dependencies/dependency_jars.json",
        "evidence/dependencies/s1_dependency_jars/"
      ],
      "notes": [
        "Step1 默认通过真实构建获取依赖结果。",
        "分支构建使用固定 commit 的隔离临时 worktree，不修改用户当前工作区。"
      ]
    },
    {
      "id": "step2",
      "order": 2,
      "title": "升级上下文",
      "script": "s2_context_from_deps.py",
      "gate": "context",
      "auto_continue_on_success": true,
      "conditional_confirmation": true,
      "interaction": {
        "type": "decision",
        "status": "awaiting_user_input",
        "question": "请确认升级口径和项目范围。已提交源码目录、源码仓库或 source_overlay 时系统会直接使用；尚未提交源码时，请决定补充源码还是明确不提供。源码可增加文件/行号、声明与注解、可读上下文和候选关系，并在受支持的常量内联场景与字节码共同形成证明；不会覆盖最终二进制裁决。不提供源码也可以继续，但报告会标注源码解释覆盖缺失。",
        "required_fields": [
          "action"
        ],
        "missing_inputs": [],
        "input_modes": [],
        "input_normalization": {
          "enabled": true,
          "required_fields": [],
          "allowed_actions": [
            "continue",
            "cancel"
          ]
        },
        "response_schema": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "continue",
                "cancel"
              ]
            },
            "base_branch": {
              "type": "string"
            },
            "current_branch": {
              "type": "string"
            },
            "jdk_base": {
              "type": "string",
              "description": "升级前实际使用的 JDK 主版本，例如 8、11、17。仅在自动识别缺失或错误时修正。"
            },
            "jdk_current": {
              "type": "string",
              "description": "升级后实际使用的 JDK 主版本，例如 17、21。仅在自动识别缺失或错误时修正。"
            },
            "springboot_base": {
              "type": "string",
              "description": "升级前 Spring Boot 版本。仅在自动识别错误时修正。"
            },
            "springboot_current": {
              "type": "string",
              "description": "升级后 Spring Boot 版本。仅在自动识别错误时修正。"
            },
            "source_dirs": {
              "type": "array",
              "description": "当 source_usage_decision=use_source 且无法自动推导业务源码范围时提供。"
            },
            "source_usage_decision": {
              "type": "string",
              "enum": [
                "use_source",
                "skip_source"
              ],
              "description": "未提交源码时必选。用户已经提交源码目录、源码仓库或 source_overlay 时直接视为 use_source，不重复确认；系统自动识别的目录不能替用户选择。"
            },
            "dependency_source_dirs": {
              "type": "array",
              "description": "可选。提供依赖源码工程目录、多模块仓库根目录或 Git 地址；Git 地址会克隆到报告内部缓存，系统随后自动推断模块坐标并派生后续所需映射。"
            },
            "source_repo_hints": {
              "type": "array",
              "description": "可选。提供源码仓库线索，支持 path、repo_path、git_path 或 {coord_hint,path,notes}，系统会只对当前系统引用的升级依赖生成建议映射。"
            },
            "accept_suggested_mappings": {
              "type": "boolean",
              "description": "可选。设为 true 时，系统会接受自动识别出的依赖源码目录结果并写入配置。默认 false（continue 不会自动覆盖现有配置）。"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "options": [
          {
            "id": "continue",
            "label": "继续",
            "description": "口径正确；已提交源码时直接使用，未提交时需明确补充源码或不提供。使用源码时系统会建立与最终制品绑定的语义覆盖。"
          },
          {
            "id": "cancel",
            "label": "稍后处理",
            "description": "保留当前分析现场，调整范围或版本信息后再继续。"
          }
        ],
        "action_requirements": {
          "continue": {
            "recommended_fields": [
              "dependency_source_dirs",
              "source_repo_hints"
            ],
            "description": "确认 target_module/project_scope；若未提交任何源码输入，继续前必须明确补充源码或不提供。用户已提交源码时直接使用，不需要二次确认。"
          }
        }
      },
      "depends_on": [
        "step1"
      ],
      "inputs": [
        "evidence/dependencies/dep_changes.csv"
      ],
      "outputs": [
        "evidence/context/context.json",
        "evidence/context/dep_graph.json"
      ]
    },
    {
      "id": "step3",
      "order": 3,
      "title": "兼容性线索",
      "script": "s3_scan.py",
      "gate": "scan",
      "interaction": null,
      "depends_on": [
        "step2"
      ],
      "inputs": [
        "evidence/context/context.json",
        "evidence/dependencies/dep_changes.csv",
        "evidence/dependencies/deps_current_resolved.csv"
      ],
      "outputs": [
        "evidence/static_scan/s3_jdk_removed_api.csv",
        "evidence/static_scan/s3_jdk_javax_refs.csv",
        "evidence/static_scan/s3_jdk_internal_api.csv",
        "evidence/static_scan/s3_jdk_reflection.csv",
        "evidence/static_scan/s3_jdk_serialization.txt",
        "evidence/static_scan/s3_jdk_runtime_flags.csv",
        "evidence/static_scan/s3_springboot_config.csv",
        "evidence/static_scan/s3_springboot_autoconfig.txt",
        "evidence/static_scan/s3_dependency_compat.csv",
        "evidence/static_scan/s3_dependency_classfile.csv"
      ],
      "notes": [
        "实际输出受 evidence/context/context.json 中的升级标志控制。"
      ]
    },
    {
      "id": "step4",
      "order": 4,
      "title": "依赖 API 变化",
      "requires_scope_confirmation": true,
      "scope_confirmation_min_candidates": 2,
      "script": "binary_pipeline.py",
      "gate": "binary_generation",
      "interaction": {
        "type": "review",
        "status": "awaiting_user_input",
        "missing_inputs": [],
        "input_modes": [],
        "input_normalization": {
          "enabled": true,
          "required_fields": [],
          "allowed_actions": [
            "continue",
            "cancel"
          ]
        },
    "question": "请选择系统触达结果的分析范围和复核范围：默认发布全部变化依赖，以保持结论覆盖完整；如果你只关心部分依赖，也可以选择部分范围，但最终报告只适用于所选范围。",
        "response_schema": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "continue",
                "cancel"
              ]
            },
            "selected_targets": {
              "type": "array",
              "description": "内部恢复字段，不向用户展示或要求用户填写。系统根据用户回复的依赖名称或完整坐标自动生成。"
            },
            "scope_mode": {
              "type": "string",
              "enum": [
                "full",
                "partial"
              ],
              "description": "内部恢复字段，不向用户展示或要求用户填写。全量分析为 full；部分分析为 partial，并同时生成 selected_targets。"
            },
            "notes": {
              "type": "string",
              "description": "可选。记录本次选择全量或部分分析范围的原因。"
            }
          }
        },
        "resume_hint": "用户回复“全量分析”时继续全部候选；用户回复“只分析”并给出依赖名称或完整坐标时，系统在内部转换为范围参数。未在卡片中展示的依赖可从 changed_dependencies.md 的“依赖包”列选择。Step4 内部证据故障不属于本确认项，由系统自动处理并记录结论边界。",
        "options": [
          {
            "id": "continue",
            "label": "选择分析范围（默认全量）",
            "description": "回复“全量分析”即可发布全部依赖的触达结果；如需部分复核，直接回复依赖名称或完整坐标。未展示的依赖可从完整依赖选择清单的“依赖包”列获取。"
          },
          {
            "id": "cancel",
            "label": "稍后处理",
            "description": "保留当前分析现场，暂不进入系统触达分析。"
          }
        ],
        "action_requirements": {
          "continue": {
            "required_fields": [
              "scope_mode"
            ],
            "description": "全量分析时直接回复“全量分析”；部分分析时直接说明要分析的依赖名称或完整坐标，系统负责转换内部参数。"
          }
        }
      },
      "depends_on": [
        "step2"
      ],
      "inputs": [
        "evidence/dependencies/dep_changes.csv",
        "evidence/context/context.json"
      ],
      "outputs": [
        ".runtime/binary_authority/active_binary_generation.json",
        "evidence/api_changes/all_changed_apis.csv",
        "evidence/api_changes/changed_dependencies.csv",
        "evidence/api_changes/changed_dependencies.md",
        "evidence/api_changes/business_bytecode_changed_api_refs.csv",
        "evidence/api_changes/business_bytecode_priority_evidence.json",
        "evidence/api_changes/review.md",
        "evidence/api_changes/s4_per_dependency/"
      ],
      "notes": [
        "binary-first 是唯一分析权威。本步骤仍发布 all_changed_apis.csv 与按依赖包分组的人工复核材料；内部二进制 generation 仅位于 .runtime/binary_authority/。"
      ]
    },
    {
      "id": "step5",
      "order": 5,
      "title": "系统触达证据",
      "auto_continue_on_success": true,
      "script": "binary_report.py",
      "gate": "binary_report",
      "interaction": null,
      "depends_on": [
        "step4"
      ],
      "inputs": [
        ".runtime/binary_authority/active_binary_generation.json",
        "evidence/api_changes/changed_dependencies.csv",
        "evidence/api_changes/all_changed_apis.csv"
      ],
      "outputs": [
        "evidence/call_chain/summary.json",
        "evidence/call_chain/summary.md",
        "evidence/call_chain/alerts.csv",
        "evidence/call_chain/by_api/",
        ".runtime/indexes/s5_query_index.json"
      ],
      "notes": [
        "系统触达结果直接消费同一个已独立验证的 binary generation；全量/部分范围仍按 changed_dependencies.md 中的依赖包坐标发布。"
      ]
    },
    {
      "id": "step6",
      "order": 6,
      "title": "分析报告",
      "script": "binary_report.py",
      "interaction": null,
      "depends_on": [
        "step5"
      ],
      "inputs": [
        "evidence/call_chain/summary.json"
      ],
      "outputs": [
        ".runtime/findings/s6_findings.json",
        "deliverables/report.md",
        "deliverables/all-affected-dependencies.md",
        "deliverables/all-affected-dependencies.csv",
        "deliverables/all-impact-details.md",
        "deliverables/all-impact-details.csv",
        "deliverables/analysis-scope.md"
      ]
    }
  ]
}
