{
  "version": "1.1",
  "runtime_controls": {
    "strict_risk_gate": {
      "type": "boolean",
      "default": false,
      "description": "启用后，Step5 门控在存在 uncertain/not_analyzed 时直接阻断，不接受带盲区的影响结论。"
    }
  },
  "steps": [
    {
      "id": "step1",
      "order": 1,
      "title": "分析对象与依赖范围",
      "script": "s1_dep_diff.py",
      "gate": "step1_scope",
      "interaction": {
        "type": "review",
        "status": "awaiting_user_input",
        "question": "请确认构建来源、目标模块和依赖变化范围是否正确。如果原本只想分析某个模块，但结果覆盖了整个项目，请补充正确的模块范围后重新分析。",
        "required_fields": [
          "action"
        ],
        "missing_inputs": [],
        "fallback_inputs": [],
        "input_modes": [],
        "input_normalization": {
          "enabled": true,
          "required_fields": [],
          "allowed_actions": [
            "continue",
            "rerun_current_step",
            "cancel"
          ]
        },
        "response_schema": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "continue",
                "rerun_current_step",
                "cancel"
              ]
            },
            "primary_module": {
              "type": "string",
              "description": "当 action=rerun_current_step 时必填。"
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "当 action=rerun_current_step 时必填，可包含一个或多个模块。"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "resume_hint": "若用户要求只分析某个模块，或用户首轮其实已明确模块但本次仍跑成 root 范围，请用结构化用户答复选择 rerun_current_step，并同时传入 primary_module/modules 重跑 Step1。",
        "options": [
          {
            "id": "continue",
            "label": "继续",
            "description": "构建结果和依赖变化范围正确，继续整理升级上下文。"
          },
          {
            "id": "rerun_current_step",
            "label": "按模块重跑",
            "description": "补充一个或多个目标模块，并重新获取这些模块的依赖变化。"
          },
          {
            "id": "cancel",
            "label": "稍后处理",
            "description": "保留当前分析现场，完成复核后再继续。"
          }
        ],
        "action_requirements": {
          "rerun_current_step": {
            "at_least_one_of": [
              "primary_module",
              "modules"
            ],
            "description": "按模块重跑时，至少要明确 primary_module 或 modules。"
          }
        }
      },
      "outputs": [
        "evidence/dependencies/dep_alerts.csv",
        "evidence/dependencies/dep_changes.csv",
        "evidence/dependencies/dep_summary.txt",
        "evidence/dependencies/deps_current_resolved.csv",
        "evidence/dependencies/build_provenance.json",
        "evidence/dependencies/s1_artifacts/"
      ],
      "notes": [
        "Step1 默认通过真实构建获取依赖结果。",
        "自动切换分支执行构建时，必须显式允许。"
      ]
    },
    {
      "id": "step2",
      "order": 2,
      "title": "升级上下文",
      "script": "s2_context_from_deps.py",
      "gate": "context",
      "interaction": {
        "type": "decision",
        "status": "awaiting_user_input",
        "question": "请确认升级口径、分支信息、目标模块及自动生成的项目范围是否正确；标准 Maven 工程无需填写业务源码目录。若已知相关依赖源码目录，也可以一并补充。",
        "required_fields": [
          "action"
        ],
        "missing_inputs": [],
        "fallback_inputs": [],
        "input_modes": [],
        "input_normalization": {
          "enabled": true,
          "required_fields": [],
          "allowed_actions": [
            "continue",
            "cancel"
          ]
        },
        "response_schema": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "continue",
                "cancel"
              ]
            },
            "base_branch": {
              "type": "string"
            },
            "current_branch": {
              "type": "string"
            },
            "source_dirs": {
              "type": "array",
              "description": "兼容/异常覆盖字段。仅当 Maven project_scope 无法推导非标准源码布局时使用。"
            },
            "dependency_source_dirs": {
              "type": "array",
              "description": "可选。直接提供依赖源码工程目录或多模块仓库根目录，系统会自动推断模块坐标并派生后续所需映射。"
            },
            "source_repo_hints": {
              "type": "array",
              "description": "可选。提供源码仓库线索，支持 path、repo_path、git_path 或 {coord_hint,path,notes}，系统会只对当前系统引用的升级依赖生成建议映射。"
            },
            "accept_suggested_mappings": {
              "type": "boolean",
              "description": "可选。设为 true 时，系统会接受自动识别出的依赖源码目录结果并写入配置。默认 false（continue 不会自动覆盖现有配置）。"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "options": [
          {
            "id": "continue",
            "label": "继续",
            "description": "口径正确；若提供了依赖源码目录或源码线索，系统会自动识别模块并生成映射建议，但不会在 continue 时覆盖已存在映射。"
          },
          {
            "id": "cancel",
            "label": "稍后处理",
            "description": "保留当前分析现场，调整范围或版本信息后再继续。"
          }
        ],
        "action_requirements": {
          "continue": {
            "recommended_fields": [
              "dependency_source_dirs",
              "source_repo_hints"
            ],
            "description": "继续前建议确认 target_module/project_scope，并按需补充依赖源码线索。"
          }
        }
      },
      "depends_on": [
        "step1"
      ],
      "inputs": [
        "evidence/dependencies/dep_changes.csv"
      ],
      "outputs": [
        "evidence/context/context.json",
        "evidence/context/dep_graph.json"
      ]
    },
    {
      "id": "step3",
      "order": 3,
      "title": "兼容性线索",
      "script": "s3_scan.py",
      "gate": "scan",
      "interaction": null,
      "depends_on": [
        "step2"
      ],
      "inputs": [
        "evidence/context/context.json",
        "evidence/dependencies/dep_changes.csv",
        "evidence/dependencies/deps_current_resolved.csv"
      ],
      "outputs": [
        "evidence/static_scan/s3_jdk_removed_api.csv",
        "evidence/static_scan/s3_jdk_javax_refs.csv",
        "evidence/static_scan/s3_jdk_internal_api.csv",
        "evidence/static_scan/s3_jdk_reflection.csv",
        "evidence/static_scan/s3_jdk_serialization.txt",
        "evidence/static_scan/s3_jdk_runtime_flags.csv",
        "evidence/static_scan/s3_springboot_config.csv",
        "evidence/static_scan/s3_springboot_autoconfig.txt",
        "evidence/static_scan/s3_dependency_compat.csv",
        "evidence/static_scan/s3_dependency_classfile.csv"
      ],
      "notes": [
        "实际输出受 evidence/context/context.json 中的升级标志控制。"
      ]
    },
    {
      "id": "step4",
      "order": 4,
      "title": "依赖 API 变化",
      "script": "s4_jar_compare.py",
      "gate": "jar_compare",
      "interaction": {
        "type": "review",
        "status": "awaiting_user_input",
        "missing_inputs": [],
        "fallback_inputs": [],
        "input_modes": [],
        "input_normalization": {
          "enabled": true,
          "required_fields": [],
          "allowed_actions": [
            "continue",
            "rerun_current_step",
            "cancel"
          ]
        },
        "question": "请确认依赖 API 变化是否完整：源码目录应覆盖相关仓库，自动识别的模块坐标和新旧版本引用应正确。若有缺失、匹配错误或对比超时，请补充信息后重新分析；若只关心部分依赖，也可以从依赖变化清单中选择。",
        "response_schema": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "continue",
                "rerun_current_step",
                "cancel"
              ]
            },
            "dependency_source_dirs": {
              "type": "array",
              "description": "当 action=rerun_current_step 时可提供依赖源码目录列表；支持单模块工程根目录或多模块仓库根目录，系统会自动推断模块坐标并派生 Step4 所需映射。"
            },
            "dependency_git_ref_overrides": {
              "type": "array",
              "description": "当源码仓库已识别但 old_version/new_version 无法自动唯一匹配 git refs 时，按依赖显式确认 old_ref/new_ref，例如 [{\"coord\":\"g:a\",\"old_ref\":\"v1\",\"new_ref\":\"v2\"}]。"
            },
            "step5_selected_coords": {
              "type": "array",
              "description": "可选。继续进入 Step5 时，只分析这些依赖坐标对应的变更 API；坐标必须来自 all_changed_apis.csv 的 coord 列。"
            },
            "step5_selected_names": {
              "type": "array",
              "description": "可选。继续进入 Step5 时，只分析这些依赖名称对应的变更 API；名称按 coord 的 artifactId 匹配。"
            },
            "step4_git_diff_timeout": {
              "type": "integer",
              "description": "可选。放宽单个依赖执行 git diff 的超时时间（秒）。"
            },
            "step4_japicmp_timeout": {
              "type": "integer",
              "description": "可选。放宽单个依赖执行 JApiCmp 的超时时间（秒）。"
            },
            "step4_fetch_timeout": {
              "type": "integer",
              "description": "可选。放宽通过 Maven dependency:get 安装 JApiCmp 工具的超时时间（秒）；不会用于下载被分析依赖。"
            },
            "notes": {
              "type": "string",
              "description": "记录用户对源码映射、git refs、缺失 jar、缺失源码映射等复核意见。"
            }
          }
        },
        "resume_hint": "若用户补充依赖源码目录、依赖 old_ref/new_ref 或 Step4 超时参数，请使用 --response-json 传回 action=rerun_current_step 与对应字段，并重跑 Step4；若用户已确认证据池，但只想让 Step5 分析部分变更 jar，可在 continue 时同时传回 step5_selected_coords / step5_selected_names；若用户要求从更早阶段重跑，请传回 action=restart_from_step 与 restart_step_id（如 step2 / step4）。",
        "options": [
          {
            "id": "continue",
            "label": "继续",
            "description": "依赖 API 变化完整可信，继续判断这些变化是否触达当前系统。"
          },
          {
            "id": "rerun_current_step",
            "label": "修正映射后重跑",
            "description": "补充依赖源码目录、修正新旧版本引用或放宽超时后，重新生成 API 变化结果。"
          },
          {
            "id": "cancel",
            "label": "稍后处理",
            "description": "保留当前分析现场，补齐依赖包或源码信息后再继续。"
          }
        ],
        "action_requirements": {
          "continue": {
            "recommended_fields": [
              "selected_targets",
              "step5_selected_coords",
              "step5_selected_names"
            ],
            "description": "若用户只想让 Step5 分析部分变更 jar，应显式选择候选目标。"
          },
          "rerun_current_step": {
            "at_least_one_of": [
              "dependency_source_dirs",
              "dependency_git_ref_overrides",
              "step4_git_diff_timeout",
              "step4_japicmp_timeout",
              "step4_fetch_timeout"
            ],
            "description": "重跑 Step4 时，至少要提供一个修正项，不能空重跑。"
          }
        }
      },
      "depends_on": [
        "step2"
      ],
      "inputs": [
        "evidence/dependencies/dep_changes.csv",
        "evidence/context/context.json"
      ],
      "outputs": [
        "evidence/api_changes/all_changed_apis.csv",
        "evidence/api_changes/git_ref_matches.txt",
        "evidence/api_changes/git_ref_matches.json"
      ],
      "notes": [
        "本步骤输出 all_changed_apis.csv，后续 Step5 默认基于该文件做反向调用链分析，也允许在 checkpoint 中指定只分析其中部分依赖。"
      ]
    },
    {
      "id": "step5",
      "order": 5,
      "title": "系统触达证据",
      "script": "s5_call_chain_engine_integrated.py",
      "gate": "call_chain",
      "interaction": {
        "type": "review",
        "status": "awaiting_user_input",
        "missing_inputs": [],
        "fallback_inputs": [],
        "input_modes": [],
        "input_normalization": {
          "enabled": true,
          "required_fields": [],
          "allowed_actions": [
            "continue",
            "rerun_current_step",
            "cancel"
          ]
        },
        "question": "请确认系统触达证据的分析结果。结论分为已确认影响、可能影响、已确认不受影响、需人工复核、缺少依赖源码或构建产物；本次未完成分析和未发现调用路径会另列为覆盖缺口。可以基于当前证据生成报告，也可以补充材料后重新分析。",
        "response_schema": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "continue",
                "rerun_current_step",
                "cancel"
              ]
            },
            "dependency_source_dirs": {
              "type": "array",
              "description": "可选。优先补充依赖源码目录；支持单模块工程或多模块仓库，系统会自动推断依赖源码映射后重跑 Step5。"
            },
            "strict_risk_gate": {
              "type": "boolean",
              "description": "可选。设为 true 时，Step5 门控会在 uncertain/not_analyzed 非零时直接阻断。"
            },
            "notes": {
              "type": "string",
              "description": "记录用户对 uncertain 项、依赖源码补充计划或重跑决定。"
            }
          }
        },
        "options": [
          {
            "id": "continue",
            "label": "继续",
            "description": "接受当前影响判定，继续生成最终报告。"
          },
          {
            "id": "rerun_current_step",
            "label": "补源码后重跑",
            "description": "补充依赖源码目录后，重新判断变更是否触达当前系统以及哪些项目仍无法确认。"
          },
          {
            "id": "cancel",
            "label": "稍后处理",
            "description": "保留当前分析现场，补齐系统调用关系证据后再继续。"
          }
        ],
        "action_requirements": {
          "continue": {
            "recommended_fields": [
              "strict_risk_gate"
            ],
            "description": "若用户要求无盲区结论，可在继续前显式打开 strict_risk_gate。"
          },
          "rerun_current_step": {
            "at_least_one_of": [
              "dependency_source_dirs"
            ],
            "description": "重跑 Step5 时，应至少补充依赖源码目录。"
          }
        }
      },
      "depends_on": [
        "step4"
      ],
      "inputs": [
        "evidence/api_changes/changed_dependencies.csv",
        "evidence/api_changes/all_changed_apis.csv"
      ],
      "outputs": [
        "evidence/call_chain/",
        ".runtime/indexes/s5_query_index.json",
        ".runtime/cache/s5_artifact_bytecode/",
        ".runtime/cache/s5_artifact_bytecode_catalog.json",
        ".runtime/cache/s5_artifact_bytecode_index.json",
        "evidence/call_chain/framework_adapters.json",
        "evidence/call_chain/source_artifact_alignment.json"
      ],
      "notes": [
        "Step5 默认会遍历 all_changed_apis.csv，并对每条变更做反向调用链追踪；若 Step4 checkpoint 指定了 changed_dependencies.csv 中的 selection_key，则只分析被选中的依赖包。"
      ]
    },
    {
      "id": "step6",
      "order": 6,
      "title": "分析报告",
      "script": "s6_report.py",
      "interaction": null,
      "depends_on": [
        "step5"
      ],
      "inputs": [
        "evidence/call_chain/summary.json"
      ],
      "outputs": [
        ".runtime/findings/s6_findings.json",
        "deliverables/report.md"
      ]
    }
  ]
}
